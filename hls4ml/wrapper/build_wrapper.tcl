# Builds the AXI-Lite wrapper lenet5_axilite around the hls4ml core. Run from this
# directory: vitis_hls -f build_wrapper.tcl
# Expects ../lenet5_project (generated by model/export.py) and ../templates.

array set opt {
    reset      1
    csim       1
    synth      1
    cosim      0
    export     0
    vsynth     0
}

set tcldir [file dirname [info script]]
source [file join $tcldir project.tcl]

set core [file normalize [file join $tcldir ../lenet5_project]]
set cflags "-std=c++0x -I[file normalize $tcldir] -I$core/firmware"

proc report_time { op_name time_start time_end } {
    set time_taken [expr $time_end - $time_start]
    set time_s [expr ($time_taken / 1000) % 60]
    set time_m [expr ($time_taken / (1000*60)) % 60]
    set time_h [expr ($time_taken / (1000*60*60)) % 24]
    puts "***** ${op_name} COMPLETED IN ${time_h}h${time_m}m${time_s}s *****"
}

if {$opt(reset)} {
    open_project -reset ${project_name}_prj
} else {
    open_project ${project_name}_prj
}
set_top ${project_name}
add_files ${project_name}.cpp -cflags $cflags
add_files $core/firmware/myproject.cpp -cflags $cflags
add_files -tb ${project_name}_test.cpp -cflags $cflags
add_files -tb $core/firmware/weights
add_files -tb $core/tb_data
if {$opt(reset)} {
    open_solution -reset "solution1"
} else {
    open_solution "solution1"
}
# solution settings as in the hls4ml build_prj.tcl (incl. the -complete_threshold fix)
catch {config_array_partition -complete_threshold $maximum_size}
config_compile -name_max_length 80
set_part $part
config_schedule -enable_dsp_full_reg=false
create_clock -period $clock_period -name default
set_clock_uncertainty $clock_uncertainty default

if {$opt(csim)} {
    puts "***** C SIMULATION *****"
    set time_start [clock clicks -milliseconds]
    csim_design
    set time_end [clock clicks -milliseconds]
    report_time "C SIMULATION" $time_start $time_end
}

if {$opt(synth)} {
    puts "***** C/RTL SYNTHESIS *****"
    set time_start [clock clicks -milliseconds]
    csynth_design
    set time_end [clock clicks -milliseconds]
    report_time "C/RTL SYNTHESIS" $time_start $time_end
}

if {$opt(cosim)} {
    puts "***** C/RTL SIMULATION *****"
    add_files -tb ${project_name}_test.cpp -cflags "$cflags -DRTL_SIM"
    set time_start [clock clicks -milliseconds]
    # -trace_level none: tracing stalled xsim on Windows (see build_prj.tcl patch in
    # model/export.py); the testbench returns non-zero on any mismatch
    cosim_design -trace_level none
    set time_end [clock clicks -milliseconds]
    report_time "C/RTL SIMULATION" $time_start $time_end
}

if {$opt(export)} {
    puts "***** EXPORT IP *****"
    set time_start [clock clicks -milliseconds]
    export_design -format ip_catalog -version $version -vendor lasatho -library hls -ipname lenet5_axilite -display_name {LeNet-5 MNIST AXI-Lite (hls4ml)} -description {LeNet-5 MNIST classifier, ap_fixed<11,5>, image and logits via AXI-Lite}
    set time_end [clock clicks -milliseconds]
    report_time "EXPORT IP" $time_start $time_end
}

if {$opt(vsynth)} {
    puts "***** VIVADO SYNTHESIS *****"
    if {[file exist ${project_name}_prj/solution1/syn/verilog]} {
        # OOC synthesis, place and route; the template sources project.tcl next to itself
        file copy -force [file join $tcldir ../templates/vivado_synth.tcl] vivado_synth.tcl
        set time_start [clock clicks -milliseconds]
        exec vivado -mode batch -source vivado_synth.tcl >@ stdout
        set time_end [clock clicks -milliseconds]
        report_time "VIVADO SYNTHESIS" $time_start $time_end
    } else {
        puts "ERROR: Cannot find generated Verilog files. Did you run C synthesis?"
        exit 1
    }
}

exit
